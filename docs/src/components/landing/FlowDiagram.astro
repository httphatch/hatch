---
const routes = [
  { domain: "myapp.test", port: "localhost:3000" },
  { domain: "api.myapp.test", port: "localhost:8080" },
  { domain: "admin.myapp.test", port: "localhost:4000" },
];
---

<div class="flow-wrap" id="flow-diagram">
  <!-- Desktop layout -->
  <div class="flow-layout" id="flow-desktop">
    <div class="flow-col" id="flow-domains">
      {routes.map((route, i) => (
        <div class="flow-card flow-card--domain" data-index={i}>
          <span class="flow-card__text">{route.domain}</span>
          <div class="flow-card__lock" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
          </div>
        </div>
      ))}
    </div>

    <svg class="flow-svg" id="flow-svg-left">
      <defs>
        <linearGradient id="pulse-grad-l" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="var(--color-accent-400)" stop-opacity="0" />
          <stop offset="40%" stop-color="var(--color-accent-400)" stop-opacity="0.9" />
          <stop offset="60%" stop-color="var(--color-accent-400)" stop-opacity="0.9" />
          <stop offset="100%" stop-color="var(--color-accent-400)" stop-opacity="0" />
        </linearGradient>
      </defs>
    </svg>

    <div class="flow-hub" id="flow-hub">
      <div class="flow-hub__pill">
        <span class="flow-hub__text">HATCH</span>
        <div class="flow-hub__glow"></div>
      </div>
    </div>

    <svg class="flow-svg" id="flow-svg-right">
      <defs>
        <linearGradient id="pulse-grad-r" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="var(--color-accent-400)" stop-opacity="0" />
          <stop offset="40%" stop-color="var(--color-accent-400)" stop-opacity="0.9" />
          <stop offset="60%" stop-color="var(--color-accent-400)" stop-opacity="0.9" />
          <stop offset="100%" stop-color="var(--color-accent-400)" stop-opacity="0" />
        </linearGradient>
      </defs>
    </svg>

    <div class="flow-col" id="flow-ports">
      {routes.map((route, i) => (
        <div class="flow-card flow-card--port" data-index={i}>
          <span class="flow-card__text">{route.port}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Mobile layout -->
  <div class="flow-mobile" id="flow-mobile">
    <div class="flow-mobile-col">
      {routes.map((route) => (
        <div class="flow-card flow-card--domain">
          <span class="flow-card__text">{route.domain}</span>
          <div class="flow-card__lock" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
          </div>
        </div>
      ))}
    </div>

    <div class="flow-mobile-line">
      <svg width="2" height="40" class="flow-mobile-svg">
        <line x1="1" y1="0" x2="1" y2="40" class="flow-path" stroke-width="2" />
      </svg>
    </div>

    <div class="flow-hub">
      <div class="flow-hub__pill">
        <span class="flow-hub__text">HATCH</span>
        <div class="flow-hub__glow"></div>
      </div>
    </div>

    <div class="flow-mobile-line">
      <svg width="2" height="40" class="flow-mobile-svg">
        <line x1="1" y1="0" x2="1" y2="40" class="flow-path" stroke-width="2" />
      </svg>
    </div>

    <div class="flow-mobile-col">
      {routes.map((route) => (
        <div class="flow-card flow-card--port">
          <span class="flow-card__text">{route.port}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .flow-wrap {
    width: 100%;
    padding: 24px 32px 48px;
  }

  /* Desktop */
  .flow-layout {
    display: flex;
    align-items: stretch;
    position: relative;
  }

  .flow-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    flex-shrink: 0;
  }

  .flow-svg {
    flex: 1;
    min-width: 60px;
    overflow: visible;
  }

  /* Mobile */
  .flow-mobile {
    display: none;
    flex-direction: column;
    align-items: center;
    padding: 0;
  }

  .flow-mobile-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .flow-mobile-line {
    display: flex;
    justify-content: center;
    padding: 4px 0;
  }

  .flow-mobile-svg {
    overflow: visible;
  }

  @media (max-width: 767px) {
    .flow-layout { display: none !important; }
    .flow-mobile { display: flex; }
    .flow-wrap { padding: 16px 24px 32px; }
  }

  /* Cards */
  .flow-card {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: white;
    border: 1.5px solid var(--color-base-200);
    white-space: nowrap;
    justify-content: center;
  }

  :global(.dark) .flow-card {
    background: var(--color-base-800);
    border-color: var(--color-base-700);
  }

  .flow-card--domain {
    position: relative;
    padding-right: 28px;
  }

  .flow-card__text {
    font-family: Geist Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-base-900);
  }

  :global(.dark) .flow-card__text {
    color: var(--color-base-200);
  }

  .flow-card--port .flow-card__text {
    font-weight: 500;
    color: var(--color-base-500);
  }

  :global(.dark) .flow-card--port .flow-card__text {
    color: var(--color-base-400);
  }

  /* Lock */
  .flow-card__lock {
    position: absolute;
    right: -14px;
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(90deg, white 50%, var(--color-base-200) 50%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  :global(.dark) .flow-card__lock {
    background: linear-gradient(90deg, var(--color-base-800) 50%, var(--color-base-700) 50%);
  }

  .flow-card__lock::before {
    content: "";
    position: absolute;
    inset: 1.5px;
    border-radius: 50%;
    background: white;
  }

  :global(.dark) .flow-card__lock::before {
    background: var(--color-base-800);
  }

  .flow-card__lock svg {
    position: relative;
    z-index: 1;
    width: 13px;
    height: 13px;
    color: var(--color-accent-500);
  }

  :global(.dark) .flow-card__lock svg {
    color: var(--color-accent-400);
  }

  /* Hub */
  .flow-hub {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    z-index: 1;
  }

  .flow-hub__pill {
    position: relative;
    padding: 12px 28px;
    background: var(--color-accent-100);
    border: 1.5px solid var(--color-accent-300);
    overflow: hidden;
  }

  :global(.dark) .flow-hub__pill {
    background: var(--color-accent-950);
    border-color: var(--color-accent-700);
  }

  .flow-hub__text {
    position: relative;
    z-index: 1;
    font-family: "Fugaz One", cursive;
    font-size: 1rem;
    color: var(--color-accent-500);
    letter-spacing: 0.06em;
  }

  .flow-hub__glow {
    position: absolute;
    inset: -1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-accent-400) 50%,
      transparent 100%
    );
    opacity: 0;
    animation: hub-glow 3s ease-in-out infinite;
  }

  :global(.dark) .flow-hub__glow {
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-accent-500) 50%,
      transparent 100%
    );
  }

  @keyframes hub-glow {
    0%, 100% { opacity: 0; }
    50% { opacity: 0.15; }
  }

  /* Connector base path */
  .flow-path {
    stroke: var(--color-accent-300);
  }

  :global(.dark) .flow-path {
    stroke: var(--color-accent-700);
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-hub__glow { animation: none; opacity: 0; }
  }

  /* Tablet */
  @media (min-width: 768px) and (max-width: 1023px) {
    .flow-card { padding: 8px 12px; }
    .flow-card--domain { padding-right: 24px; }
    .flow-card__text { font-size: 0.8rem; }
    .flow-card__lock { width: 24px; height: 24px; right: -12px; }
    .flow-card__lock svg { width: 11px; height: 11px; }
    .flow-hub__pill { padding: 10px 20px; }
    .flow-hub__text { font-size: 0.88rem; }
  }
</style>

<script>
  function initFlowDiagram() {
    const layout = document.getElementById('flow-desktop');
    if (!layout || getComputedStyle(layout).display === 'none') return;

    const svgL = document.getElementById('flow-svg-left') as SVGSVGElement | null;
    const svgR = document.getElementById('flow-svg-right') as SVGSVGElement | null;
    const hub = document.getElementById('flow-hub');
    if (!svgL || !svgR || !hub) return;

    const domains = layout.querySelectorAll('#flow-domains .flow-card');
    const ports = layout.querySelectorAll('#flow-ports .flow-card');

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function getCenter(el: Element, relativeTo: Element) {
      const elRect = el.getBoundingClientRect();
      const refRect = relativeTo.getBoundingClientRect();
      return {
        x: elRect.left + elRect.width / 2 - refRect.left,
        y: elRect.top + elRect.height / 2 - refRect.top,
      };
    }

    function drawSide(svg: SVGSVGElement, cards: NodeListOf<Element>, hubEl: Element, side: 'left' | 'right') {
      const svgRect = svg.getBoundingClientRect();
      const w = svgRect.width;
      const h = svgRect.height;

      svg.setAttribute('viewBox', `0 0 ${w} ${h}`);

      // Remove old paths (keep defs)
      svg.querySelectorAll('path, rect').forEach(el => el.remove());

      const hubCenter = getCenter(hubEl, svg);

      cards.forEach((card, i) => {
        const cardCenter = getCenter(card, svg);

        let d: string;
        if (side === 'left') {
          const cp1x = cardCenter.x + w * 0.4;
          const cp2x = hubCenter.x - w * 0.4;
          d = `M ${cardCenter.x} ${cardCenter.y} C ${cp1x} ${cardCenter.y}, ${cp2x} ${hubCenter.y}, ${hubCenter.x} ${hubCenter.y}`;
        } else {
          const cp1x = hubCenter.x + w * 0.4;
          const cp2x = cardCenter.x - w * 0.4;
          d = `M ${hubCenter.x} ${hubCenter.y} C ${cp1x} ${hubCenter.y}, ${cp2x} ${cardCenter.y}, ${cardCenter.x} ${cardCenter.y}`;
        }

        // Base path
        const basePath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        basePath.setAttribute('d', d);
        basePath.setAttribute('fill', 'none');
        basePath.setAttribute('class', 'flow-path');
        basePath.setAttribute('stroke-width', '2');
        svg.appendChild(basePath);

        if (reducedMotion) return;

        // Pulse overlay: a shorter path segment that moves along the curve
        const pulsePath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        pulsePath.setAttribute('d', d);
        pulsePath.setAttribute('fill', 'none');
        pulsePath.setAttribute('stroke', `url(#pulse-grad-${side === 'left' ? 'l' : 'r'})`);
        pulsePath.setAttribute('stroke-width', '4');

        const pathLength = basePath.getTotalLength();
        const pulseLen = pathLength * 0.3;
        pulsePath.setAttribute('stroke-dasharray', `${pulseLen} ${pathLength}`);
        pulsePath.setAttribute('stroke-dashoffset', `${pulseLen}`);

        pulsePath.style.animation = `pulse-flow ${1.8 + i * 0.15}s ease-in-out infinite`;
        pulsePath.style.animationDelay = `${i * 0.5}s`;
        pulsePath.dataset.pathLength = String(pathLength);
        pulsePath.dataset.pulseLen = String(pulseLen);

        svg.appendChild(pulsePath);
      });
    }

    function draw() {
      if (getComputedStyle(layout!).display === 'none') return;
      drawSide(svgL!, domains, hub!, 'left');
      drawSide(svgR!, ports, hub!, 'right');
    }

    draw();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(draw, 100);
    });
  }

  // Inject the keyframe dynamically since stroke-dashoffset end depends on path length
  const style = document.createElement('style');
  style.textContent = `
    @keyframes pulse-flow {
      0% { stroke-dashoffset: var(--pulse-start); opacity: 0; }
      10% { opacity: 1; }
      90% { opacity: 1; }
      100% { stroke-dashoffset: var(--pulse-end); opacity: 0; }
    }
  `;
  document.head.appendChild(style);

  // Override animation with computed values after paths are drawn
  function activatePulses() {
    document.querySelectorAll('#flow-svg-left path[data-path-length], #flow-svg-right path[data-path-length]').forEach(p => {
      const el = p as SVGPathElement;
      const pathLen = parseFloat(el.dataset.pathLength || '0');
      const pulseLen = parseFloat(el.dataset.pulseLen || '0');
      el.style.setProperty('--pulse-start', String(pulseLen));
      el.style.setProperty('--pulse-end', String(-pathLen));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => { initFlowDiagram(); activatePulses(); });
  } else {
    initFlowDiagram();
    activatePulses();
  }
</script>
