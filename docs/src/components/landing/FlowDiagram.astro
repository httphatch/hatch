---
import Logo from "@/components/assets/Logo.astro";

const routes = [
  { domain: "myapp.test", port: "localhost:3000" },
  { domain: "api.myapp.test", port: "localhost:8080" },
  { domain: "admin.myapp.test", port: "localhost:4000" },
];

const dur = "2s";

const y1 = 13.5;
const y2 = 50;
const y3 = 86.5;

const leftPaths = [
  `M 0 ${y1} C 60 ${y1}, 40 ${y2}, 100 ${y2}`,
  `M 0 ${y2} L 100 ${y2}`,
  `M 0 ${y3} C 60 ${y3}, 40 ${y2}, 100 ${y2}`,
];

const rightPaths = [
  `M 0 ${y2} C 60 ${y2}, 40 ${y1}, 100 ${y1}`,
  `M 0 ${y2} L 100 ${y2}`,
  `M 0 ${y2} C 60 ${y2}, 40 ${y3}, 100 ${y3}`,
];
---

<!-- Desktop layout (md+) -->
<div class="flow-diagram hidden md:block">
  <div class="flow-layout">
    <div class="flow-col">
      {routes.map((route) => (
        <div class="flow-card flow-card--domain">
          <span class="flow-card__text">{route.domain}</span>
          <div class="flow-card__lock" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
          </div>
        </div>
      ))}
    </div>

    <svg class="flow-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
      {leftPaths.map((p) => (
        <path d={p} fill="none" class="flow-path" stroke-width="2" vector-effect="non-scaling-stroke" />
      ))}
      {leftPaths.map((p, i) => (
        <>
          <circle r="2.5" class="flow-dot" vector-effect="non-scaling-stroke">
            <animateMotion dur={dur} repeatCount="indefinite" path={p} begin={`${i * 0.7}s`} />
          </circle>
          <circle r="2.5" class="flow-dot" vector-effect="non-scaling-stroke">
            <animateMotion dur={dur} repeatCount="indefinite" path={p} begin={`${i * 0.7 + 1}s`} />
          </circle>
        </>
      ))}
    </svg>

    <div class="flow-hub">
      <div class="flow-hub__pill">
        <Logo class="text-base" />
      </div>
    </div>

    <svg class="flow-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
      {rightPaths.map((p) => (
        <path d={p} fill="none" class="flow-path" stroke-width="2" vector-effect="non-scaling-stroke" />
      ))}
      {rightPaths.map((p, i) => (
        <>
          <circle r="2.5" class="flow-dot" vector-effect="non-scaling-stroke">
            <animateMotion dur={dur} repeatCount="indefinite" path={p} begin={`${i * 0.7 + 0.3}s`} />
          </circle>
          <circle r="2.5" class="flow-dot" vector-effect="non-scaling-stroke">
            <animateMotion dur={dur} repeatCount="indefinite" path={p} begin={`${i * 0.7 + 1.3}s`} />
          </circle>
        </>
      ))}
    </svg>

    <div class="flow-col">
      {routes.map((route) => (
        <div class="flow-card flow-card--port">
          <span class="flow-card__text">{route.port}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<!-- Mobile layout (<md) -->
<div class="flow-diagram-mobile md:hidden">
  <div class="flow-mobile-col">
    {routes.map((route) => (
      <div class="flow-card flow-card--domain">
        <span class="flow-card__text">{route.domain}</span>
        <div class="flow-card__lock" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </div>
      </div>
    ))}
  </div>

  <svg class="flow-svg-vertical" viewBox="0 0 100 100" preserveAspectRatio="none">
    <path d="M 50 0 L 50 100" fill="none" class="flow-path" stroke-width="2" vector-effect="non-scaling-stroke" />
    <circle r="2.5" class="flow-dot" vector-effect="non-scaling-stroke">
      <animateMotion dur={dur} repeatCount="indefinite" path="M 50 0 L 50 100" begin="0s" />
    </circle>
    <circle r="2.5" class="flow-dot" vector-effect="non-scaling-stroke">
      <animateMotion dur={dur} repeatCount="indefinite" path="M 50 0 L 50 100" begin="1s" />
    </circle>
  </svg>

  <div class="flow-hub">
    <div class="flow-hub__pill">
      <Logo class="text-base" />
    </div>
  </div>

  <svg class="flow-svg-vertical" viewBox="0 0 100 100" preserveAspectRatio="none">
    <path d="M 50 0 L 50 100" fill="none" class="flow-path" stroke-width="2" vector-effect="non-scaling-stroke" />
    <circle r="2.5" class="flow-dot" vector-effect="non-scaling-stroke">
      <animateMotion dur={dur} repeatCount="indefinite" path="M 50 0 L 50 100" begin="0.3s" />
    </circle>
    <circle r="2.5" class="flow-dot" vector-effect="non-scaling-stroke">
      <animateMotion dur={dur} repeatCount="indefinite" path="M 50 0 L 50 100" begin="1.3s" />
    </circle>
  </svg>

  <div class="flow-mobile-col">
    {routes.map((route) => (
      <div class="flow-card flow-card--port">
        <span class="flow-card__text">{route.port}</span>
      </div>
    ))}
  </div>
</div>

<style>
  /* Desktop layout */
  .flow-diagram {
    width: 100%;
    padding: 16px 24px 48px;
  }

  .flow-layout {
    display: flex;
    align-items: stretch;
  }

  .flow-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    flex-shrink: 0;
  }

  .flow-svg {
    flex: 1;
    min-width: 40px;
    overflow: visible;
  }

  /* Mobile layout */
  .flow-diagram-mobile {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16px 24px 32px;
  }

  .flow-mobile-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .flow-svg-vertical {
    width: 40px;
    height: 40px;
    overflow: visible;
  }

  /* Shared card styles */
  .flow-card {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: white;
    border: 1.5px solid var(--color-base-200);
    white-space: nowrap;
    justify-content: center;
  }

  :global(.dark) .flow-card {
    background: var(--color-base-800);
    border-color: var(--color-base-700);
  }

  .flow-card--domain {
    position: relative;
    padding-right: 28px;
  }

  .flow-card__text {
    font-family: Geist Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-base-900);
  }

  :global(.dark) .flow-card__text {
    color: var(--color-base-200);
  }

  .flow-card--port .flow-card__text {
    font-weight: 500;
    color: var(--color-base-500);
  }

  :global(.dark) .flow-card--port .flow-card__text {
    color: var(--color-base-400);
  }

  /* Lock icon */
  .flow-card__lock {
    position: absolute;
    right: -14px;
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(
      90deg,
      white 0%,
      white 50%,
      var(--color-base-200) 50%,
      var(--color-base-200) 100%
    );
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  :global(.dark) .flow-card__lock {
    background: linear-gradient(
      90deg,
      var(--color-base-800) 0%,
      var(--color-base-800) 50%,
      var(--color-base-700) 50%,
      var(--color-base-700) 100%
    );
  }

  .flow-card__lock::before {
    content: "";
    position: absolute;
    inset: 1.5px;
    border-radius: 50%;
    background: white;
  }

  :global(.dark) .flow-card__lock::before {
    background: var(--color-base-800);
  }

  .flow-card__lock svg {
    position: relative;
    z-index: 1;
    width: 13px;
    height: 13px;
    color: var(--color-accent-500);
  }

  :global(.dark) .flow-card__lock svg {
    color: var(--color-accent-400);
  }

  /* Hub */
  .flow-hub {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    z-index: 1;
  }

  .flow-hub__pill {
    padding: 10px 22px;
    background: var(--color-accent-100);
  }

  :global(.dark) .flow-hub__pill {
    background: var(--color-accent-950);
  }

  /* SVG connectors and dots */
  .flow-path {
    stroke: var(--color-accent-300);
  }

  :global(.dark) .flow-path {
    stroke: var(--color-accent-700);
  }

  .flow-dot {
    fill: var(--color-accent-400);
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-dot {
      display: none;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 768px) and (max-width: 1023px) {
    .flow-card {
      padding: 8px 12px;
    }

    .flow-card--domain {
      padding-right: 24px;
    }

    .flow-card__text {
      font-size: 0.8rem;
    }

    .flow-card__lock {
      width: 24px;
      height: 24px;
      right: -12px;
    }

    .flow-card__lock svg {
      width: 11px;
      height: 11px;
    }

    .flow-hub__pill {
      padding: 8px 16px;
    }
  }
</style>
